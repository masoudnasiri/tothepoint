# Rivar root environment template (no real secrets)

# Runtime mode
ENVIRONMENT=development
DEBUG=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Frontend build arg consumed by docker-compose
REACT_APP_API_URL=http://localhost:8000

# Backend security
SECRET_KEY=change-this-in-real-environments

# Optional Phase 3 feature flags
ENABLE_PACKAGE_PROCUREMENT=false
LEGACY_PROJECT_ITEM_FALLBACK=true
SUPPLIER_NORMALIZATION_ENFORCED=false
ENABLE_PACKAGE_BASED_OPTIMIZATION=false
REQUIRE_PACKAGE_ID_FOR_NEW_OPTIONS=false

# Rivar backend environment template (no real secrets)

DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/procurement_dss
SECRET_KEY=change-this-in-real-environments
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 3 feature flags
ENABLE_PACKAGE_PROCUREMENT=false
LEGACY_PROJECT_ITEM_FALLBACK=true
SUPPLIER_NORMALIZATION_ENFORCED=false
ENABLE_PACKAGE_BASED_OPTIMIZATION=false
REQUIRE_PACKAGE_ID_FOR_NEW_OPTIONS=false
ENFORCE_PACKAGE_COVERAGE_ON_LOCK=false
